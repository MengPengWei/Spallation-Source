# 批处理模式运行宏 - 无可视化
# 用法: ./Hadr07 run_batch.mac

# 设置详细程度
/control/verbose 2
/run/verbose 2
/event/verbose 0
/tracking/verbose 0

# 初始化内核
/run/initialize

# 设置源（从source_2026_requirements.mac）
/gun/particle gamma
/gun/energy 1.0 MeV
/gun/position 0. 0. 90. cm
/gun/direction 0. 0. 1.

# 运行事件
/run/beamOn 10000
